# PostgreSQL connection (docker compose up -d db)
DATABASE_URL=postgresql://tennis:tennis@localhost:5432/tennis?schema=public

# HTTP
PORT=4000
HOST=0.0.0.0
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Number of worker threads verifying submitted careers (replay)
VERIFY_WORKERS=2

LOG_LEVEL=info
