{
  "name": "@ttg/api",
  "version": "1.0.0",
  "private": true,
  "description": "API rankingów, kariery dnia i weryfikacji wyników (Fastify + Prisma + PostgreSQL).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@prisma/client": "^6.1.0",
    "@ttg/engine": "*",
    "@ttg/shared": "*",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "tsup": "^8.3.5"
  }
}
